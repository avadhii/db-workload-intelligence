# ─── Target Database ─────────────────────────────────────────────────
# The PostgreSQL instance running the application workload.
TARGET_DB_USER=targetuser
TARGET_DB_PASSWORD=targetpass
TARGET_DB_NAME=targetdb
TARGET_DB_HOST=localhost
TARGET_DB_PORT=5433

# ─── Metrics Store ───────────────────────────────────────────────────
# Separate PostgreSQL instance for storing collected telemetry.
METRICS_DB_USER=metricsuser
METRICS_DB_PASSWORD=metricspass
METRICS_DB_NAME=metricsdb
METRICS_DB_HOST=localhost
METRICS_DB_PORT=5434

# ─── Collector ────────────────────────────────────────────────────────
COLLECT_INTERVAL=30   # seconds between snapshots

# ─── Grafana ─────────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ─── API ─────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
